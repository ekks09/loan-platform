services:
  - type: web
    name: {{NAME}}
    runtime: python
    plan: {{PLAN}}
    region: frankfurt
    branch: {{BRANCH}}
    healthCheckPath: /health/
    buildCommand: |
      pip install --upgrade pip
      pip install -r Backend/requirements.txt
      python Backend/manage.py collectstatic --noinput
    startCommand: |
      python Backend/manage.py check_config --allow-test-mode
      python Backend/manage.py migrate --noinput
      gunicorn core.wsgi:application \
        --chdir Backend \
        --bind 0.0.0.0:$PORT \
        --workers 2 \
        --threads 4 \
        --timeout 60 \
        --access-logfile - \
        --error-logfile -
    autoDeploy: {{AUTODEPLOY}}
    envVars:
      # Pinned to the interpreter CI tests (3.11.x). The deploy that failed ran
      # 3.13.4 because its environment had been configured by hand.
      - key: PYTHON_VERSION
        value: 3.11.9

      # Release promotion stamp: staging deploys pin the source they
      # rehearsed; production must carry the identical SHA (see
      # docs/RELEASE_PROCESS.md — no config drift, no source drift).
      - key: GIT_SHA
        sync: false

      # --- Core Django ---------------------------------------------------
      - key: DJANGO_SECRET_KEY
        generateValue: true
      - key: DEPLOY_ENVIRONMENT
        value: "{{DEPLOY_ENVIRONMENT}}"
      - key: DJANGO_DEBUG
        value: "false"
      - key: DJANGO_ALLOW_INSECURE_SECRETS
        value: "false"
      # Leave blank to derive from Render's RENDER_EXTERNAL_HOSTNAME.
      - key: DJANGO_ALLOWED_HOSTS
        sync: false
      # Leave blank to derive https://RENDER_EXTERNAL_HOSTNAME.
      - key: DJANGO_CSRF_TRUSTED_ORIGINS
        sync: false
      - key: DJANGO_SECURE_SSL
        value: "true"
      # Keep HSTS off until the custom domain is final; then set a 12-month max-age.
      - key: DJANGO_HSTS_SECONDS
        value: "0"
      - key: TRUST_PROXY_HEADERS
        value: "true"
      - key: DJANGO_LOG_LEVEL
        value: "INFO"

      # --- API surface ---------------------------------------------------
      # Same-origin deployment: the Django service also serves the pages, so
      # this stays a relative path. Set an absolute URL only for a split
      # frontend, together with CORS_ALLOWED_ORIGINS on this service.
      - key: API_BASE_URL
        value: /api/v1
      - key: CORS_ALLOWED_ORIGINS
        sync: false

      # --- Database (Supabase Postgres) ---------------------------------
      - key: SUPABASE_DB_HOST
        sync: false
      - key: SUPABASE_DB_PORT
        value: "5432"
      - key: SUPABASE_DB_NAME
        value: postgres
      - key: SUPABASE_DB_USER
        value: postgres
      - key: SUPABASE_DB_PASSWORD
        sync: false
      - key: SUPABASE_DB_SSLMODE
        value: require

      # --- Private document storage -------------------------------------
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_SERVICE_KEY
        sync: false
      - key: SUPABASE_STORAGE_BUCKET
        value: identity-documents
      - key: SUPABASE_STORAGE_PRIVATE
        value: "true"
      # Start false so the service can boot before the bucket is provisioned.
      # Set to true once document upload must be mandatory for readiness.
      - key: REQUIRE_DOCUMENT_STORAGE
        value: "{{REQUIRE_DOCUMENT_STORAGE}}"
      - key: DOCUMENT_SIGNED_URL_TTL
        value: "300"
      - key: DOCUMENT_RETENTION_DAYS
        value: "{{DOCUMENT_RETENTION_DAYS}}"

      # --- Payments: posture is a dashboard decision ----------------------
      # These six keys are `sync: false` ON PURPOSE. If the blueprint pinned
      # PAYMENTS_ENABLED=false, a later Blueprint sync would reset a dashboard
      # "true" back to false while the dashboard-only Paystack keys stayed
      # behind - the exact "keys set while payments are disabled" boot failure.
      # Unset is safe: settings default to payments off, live mode off, fee
      # collection disabled and unapproved, and the app refuses ambiguous
      # combinations at startup.
      #
      # Choose exactly ONE posture in Render -> Environment:
      #
      #   A) Payments OFF (fastest green deploy)
      #        remove PAYSTACK_SECRET_KEY and PAYSTACK_PUBLIC_KEY;
      #        PAYMENTS_ENABLED=false, PAYMENTS_LIVE_MODE=false,
      #        FEE_COLLECTION_MODE=disabled, FEE_COLLECTION_APPROVED=false.
      #
      #   B) Payments ON in TEST mode (full demo, no real money can move)
      #        PAYMENTS_ENABLED=true, PAYMENTS_LIVE_MODE=false,
      #        PAYSTACK_SECRET_KEY=sk_test_..., PAYSTACK_PUBLIC_KEY=pk_test_...,
      #        FEE_COLLECTION_MODE=upfront, FEE_COLLECTION_APPROVED=true.
      #
      # Never set PAYMENTS_LIVE_MODE=true on staging: settings refuse to boot.
      # Never commit a key: both Paystack values are sync: false.
      - key: PAYMENTS_ENABLED
        sync: false
      - key: PAYMENTS_LIVE_MODE
        sync: false
      - key: PAYSTACK_SECRET_KEY
        sync: false
      - key: PAYSTACK_PUBLIC_KEY
        sync: false
      - key: FEE_COLLECTION_MODE
        sync: false
      - key: FEE_COLLECTION_APPROVED
        sync: false

      # --- Legal / display ----------------------------------------------
      - key: LEGAL_TERMS_APPROVED
        value: "false"
      - key: TERMS_VERSION
        value: "2026-10-draft"
      - key: PRIVACY_VERSION
        value: "2026-10-draft"
      - key: CONSENT_VERSION
        value: "2026-10-draft"
      - key: PLATFORM_NAME
        value: PesaFix
      - key: PLATFORM_LICENCE_STATUS
        value: Licence status not yet published
      - key: INTERNAL_EMAIL_DOMAIN
        value: example.com

      # --- Notifications ------------------------------------------------
      # Values come from the per-environment params files; keep them
      # unquoted there — this template adds the YAML quoting.
      - key: SMS_BACKEND
        value: "{{SMS_BACKEND}}"

      # --- Auth / throttling -------------------------------------------
      - key: JWT_ACCESS_TTL_MINUTES
        value: "30"
      - key: JWT_ISSUER
        value: loan-platform-ke
      - key: JWT_AUDIENCE
        value: loan-platform-ke-web
      - key: THROTTLE_ANON
        value: "{{THROTTLE_ANON}}"
      - key: THROTTLE_USER
        value: "{{THROTTLE_USER}}"
