# Environment for the LOCAL docker-compose stack only. Copy to .env.compose.
#
# These are development placeholders, never usable elsewhere: the compose
# stack exists for reproducible local verification (PostgreSQL + MinIO)
# and is NOT a production deployment description. Production values live in
# the hosting platform's secret store (see render.yaml / docs).
#
# Do not put real credentials in .env.compose — the file is docker-local but
# still excluded from git; .env.compose.example is the only committed copy.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=compose-local-dev-only-secret-key-not-for-any-deployment
DJANGO_ALLOW_INSECURE_SECRETS=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database (postgres:15 service, production-major) ----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=compose-local-dev-password
POSTGRES_DB=postgres
SUPABASE_DB_HOST=db
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=compose-local-dev-password
SUPABASE_DB_SSLMODE=disable

# --- Document storage (MinIO, S3-compatible test of the real adapter) ------
DOCUMENT_STORE=s3
REQUIRE_DOCUMENT_STORAGE=true
DOCUMENT_SIGNED_URL_TTL=300
DOCUMENT_RETENTION_DAYS=90
MINIO_ROOT_USER=compose-minio-access
MINIO_ROOT_PASSWORD=compose-minio-secret
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=compose-minio-access
S3_SECRET_KEY=compose-minio-secret
S3_BUCKET=identity-documents

# --- Payments / legal / notifications --------------------------------------
# Deliberately inert locally: no provider credentials, no delivery.
PAYMENT_PROVIDER=paystack
PAYMENTS_ENABLED=false
PAYMENTS_LIVE_MODE=false
FEE_COLLECTION_MODE=disabled
LEGAL_TERMS_APPROVED=false
TERMS_VERSION=2026-10-draft
PRIVACY_VERSION=2026-10-draft
CONSENT_VERSION=2026-10-draft
PLATFORM_NAME=PesaFix
SMS_BACKEND=console

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_TTL_MINUTES=30
JWT_ISSUER=loan-platform
JWT_AUDIENCE=loan-platform-users
INTERNAL_EMAIL_DOMAIN=example.com
