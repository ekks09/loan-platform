# DEMO preset — the full product flow, enabled end to end, zero real money.
# Copy to Backend/.env (or source it) for demos and stakeholder walkthroughs.
#
# What this enables:
#   * payments ON via Paystack TEST keys (no real money can ever move);
#   * upfront fee collection ON (fee is charged at offer acceptance, after
#     approval — the only time a fee may be taken);
#   * legal/terms flags ON so the boot gates agree to run;
#   * document storage REQUIRED (uploads actually work — see the two store
#     options below).
#
# What this deliberately does NOT do:
#   * PAYMENTS_LIVE_MODE stays OFF. The codebase boot-fatal stops:
#       - live mode + a non-sk_live_ secret key  (always),
#       - live mode on a staging deployment      (always).
#     A demo NEVER wants real-money mode: one leaked sk_live key in a screen
#     share becomes a real-liability incident. The entire happy path demos
#     identically with test keys (init → checkout page → webhook → transfer
#     "success" → repayment), including failure/reversal drills.
#     Flip to live only after the legal gates in docs/RELEASE_PROCESS.md are
#     signed — and if that day comes, expect real money to move.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=demo-only-secret-key-not-for-any-deployment-0002
DJANGO_ALLOW_INSECURE_SECRETS=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DEPLOY_ENVIRONMENT=development
API_BASE_URL=/api/v1

# --- Database ---------------------------------------------------------------
DJANGO_DEV_SQLITE=1
DJANGO_SQLITE_PATH=dev.sqlite3

# --- Document storage (REQUIRED in demo — uploads must work) ----------------
REQUIRE_DOCUMENT_STORAGE=true
DOCUMENT_SIGNED_URL_TTL=300
DOCUMENT_RETENTION_DAYS=30
# Option A (default): MinIO via the compose stack — `docker compose up -d minio
# minio-init` gives you storage with zero external accounts.
DOCUMENT_STORE=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=compose-minio-access
S3_SECRET_KEY=compose-minio-secret
S3_BUCKET=identity-documents
# Option B: a real Supabase project (fill in, then flip DOCUMENT_STORE):
# DOCUMENT_STORE=supabase
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key>
# SUPABASE_STORAGE_BUCKET=identity-documents

# --- Payments (ON, TEST mode) -----------------------------------------------
PAYMENT_PROVIDER=paystack
PAYMENTS_ENABLED=true
# Stays false. See the header for why; boot will also refuse an inconsistent
# key/mode combination, so you cannot enable the two wrongly by accident.
PAYMENTS_LIVE_MODE=false
# Paste YOUR Paystack test keys below (dashboard → Settings → API Keys).
# Boot accepts these placeholders, but payment init will 401 until real test
# keys are present — the only line of external configuration this demo needs.
PAYSTACK_SECRET_KEY=sk_test_replace_me_with_your_paystack_test_secret
PAYSTACK_PUBLIC_KEY=pk_test_replace_me_with_your_paystack_test_public
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Fees (ON) ---------------------------------------------------------------
FEE_COLLECTION_MODE=upfront
FEE_COLLECTION_APPROVED=true

# --- Legal/display gates (ON for demo; drafts still displayed) ---------------
LEGAL_TERMS_APPROVED=true
TERMS_VERSION=2026-10-draft
PRIVACY_VERSION=2026-10-draft
CONSENT_VERSION=2026-10-draft
PLATFORM_NAME=PesaFix
PLATFORM_LICENCE_STATUS=Licence status not yet published
INTERNAL_EMAIL_DOMAIN=example.com

# --- Notifications ------------------------------------------------------------
# console = OTP/code appears in the server log; use this in the demo to show
# the password-reset flow without an SMS contract. Switch to africastalking
# (with real creds) to demo real delivery.
SMS_BACKEND=console
NOTIFICATION_MAX_RETRIES=1
NOTIFICATION_RETRY_BACKOFF_SECONDS=0.5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Auth ----------------------------------------------------------------------
JWT_ACCESS_TTL_MINUTES=30
JWT_ISSUER=loan-platform
JWT_AUDIENCE=loan-platform-users
