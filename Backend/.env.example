# Copy to Backend/.env for local development. Never commit the real file.
# Values are read once at startup; real environment variables override this file.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-secret-key-that-is-not-used-in-any-deployment-0001
DJANGO_ALLOW_INSECURE_SECRETS=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- PWA service worker cache --------------------------------------------
# Plain static-file serving (no manifest storage), so cache invalidation is
# version-driven. Default: deterministic fingerprint of the app shell — only
# set this to override with your pipeline's build id / commit SHA.
# PWA_CACHE_VERSION=

# --- API surface ----------------------------------------------------------
# The browser calls this path on the origin that served the page. Keep the
# default; only a split frontend/API deployment needs an absolute URL, and
# then the API service also needs CORS_ALLOWED_ORIGINS set to the frontend.
API_BASE_URL=/api/v1
# Comma-separated exact origins. Wildcards are rejected outside DEBUG.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Database -------------------------------------------------------------
# Local development uses SQLite. Production must use Postgres.
DJANGO_DEV_SQLITE=1
DJANGO_SQLITE_PATH=dev.sqlite3
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_SSLMODE=require

# --- Document storage (private bucket) ------------------------------------
# DOCUMENT_STORE selects the adapter: "supabase" (default) or "s3".
# Without credentials, registration works but document upload is rejected.
DOCUMENT_STORE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=identity-documents
SUPABASE_STORAGE_PRIVATE=true
# S3-compatible alternative (MinIO local, AWS S3 / compatible production):
# DOCUMENT_STORE=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000  # only for split-horizon setups
# (server reaches minio:9000 inside a network while the browser uses localhost)
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=identity-documents
REQUIRE_DOCUMENT_STORAGE=false
DOCUMENT_SIGNED_URL_TTL=300
DOCUMENT_RETENTION_DAYS=90

# --- Payments -------------------------------------------------------------
# Payments are off by default. PAYMENT_PROVIDER selects the adapter used by
# the business layer (currently only "paystack"; validated at startup).
# To test against Paystack *test* keys, set PAYMENTS_ENABLED=true and provide
# both keys; live keys are refused unless PAYMENTS_LIVE_MODE=true, which
# additionally requires LEGAL_TERMS_APPROVED.
PAYMENT_PROVIDER=paystack
PAYMENTS_ENABLED=false
PAYMENTS_LIVE_MODE=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FEE_COLLECTION_MODE=disabled
FEE_COLLECTION_APPROVED=false

# --- Legal / display ------------------------------------------------------
LEGAL_TERMS_APPROVED=false
TERMS_VERSION=2026-10-draft
PRIVACY_VERSION=2026-10-draft
CONSENT_VERSION=2026-10-draft
PLATFORM_NAME=PesaFix
PLATFORM_LEGAL_NAME=
PLATFORM_LICENCE_STATUS=Licence status not yet published
PLATFORM_LICENCE_NUMBER=
PLATFORM_SUPPORT_PHONE=
PLATFORM_SUPPORT_EMAIL=
PLATFORM_ADDRESS=
INTERNAL_EMAIL_DOMAIN=example.com

# --- Notifications ----------------------------------------------------------
# console prints messages to the server log (development only);
# none disables delivery (allowed transactional messages then fall back to the
# in-app channel for signed-in users; OTP codes never fall back).
SMS_BACKEND=console
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=
# Bounded retry for transient provider failures: 1 + N attempts total.
NOTIFICATION_MAX_RETRIES=1
NOTIFICATION_RETRY_BACKOFF_SECONDS=0.5
# Minimum seconds between two OTP SMS for the same number.
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_TTL_MINUTES=30
JWT_ISSUER=loan-platform
JWT_AUDIENCE=loan-platform-users

# Optional manual M-Pesa collection shortcuts. Leave empty unless a
# confirmed operating Paybill/Till exists; the UI never invents one.
MPESA_PAYBILL_NUMBER=
MPESA_TILL_NUMBER=
